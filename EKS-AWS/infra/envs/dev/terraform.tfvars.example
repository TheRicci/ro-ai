project_name               = "ro-ai"
environment                = "dev"
aws_region                 = "us-east-1"
network_name               = "ro-ai-dev"
vpc_cidr                   = "10.0.0.0/16"
availability_zones         = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs        = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs       = ["10.0.10.0/24", "10.0.11.0/24"]
cluster_name               = "ro-ai-dev"
kubernetes_version         = "1.35"
cluster_security_group_ids = []
endpoint_private_access    = true
endpoint_public_access     = true
enabled_cluster_log_types  = []
node_group_name            = "core"
node_instance_types        = ["m7i.large"]
node_capacity_type         = "ON_DEMAND"
node_desired_size          = 2
node_min_size              = 2
node_max_size              = 3
node_disk_size             = 20
node_labels = {
  role        = "core"
  environment = "dev"
}
node_max_unavailable       = 1
coredns_addon_version      = null
kube_proxy_addon_version   = null
vpc_cni_addon_version      = null
pod_identity_agent_version = null
addon_resolve_conflicts_on_create = "OVERWRITE"
addon_resolve_conflicts_on_update = "OVERWRITE"
bot_memory_table_name      = "ro-ai-dev-bot-memory"
bot_memory_partition_key   = "bot_id"
bot_memory_sort_key        = "memory_key"
bot_memory_billing_mode    = "PAY_PER_REQUEST"
bot_artifacts_bucket_name  = "ro-ai-dev-bot-artifacts-REPLACE_ME_ACCOUNT_ID"
enable_point_in_time_recovery = true
enable_bucket_versioning   = false
world_db_identifier        = "ro-ai-dev-world"
world_db_engine            = "mariadb"
world_db_engine_version    = null
world_db_instance_class    = "db.t3.micro"
world_db_allocated_storage = 20
world_db_max_allocated_storage = 100
world_db_name              = "ragnarok"
world_db_username          = "ragnarok"
world_db_port              = 3306
world_db_secret_name       = "ro-ai/dev/world-db"
world_db_skip_final_snapshot = true
world_db_deletion_protection = false
world_db_backup_retention_period = 7
intelligence_secret_name   = "ro-ai/dev/intelligence"
bot_runtime_secret_name    = "ro-ai/dev/bot-runtime"
